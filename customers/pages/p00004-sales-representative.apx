page 4 (
    name: Sales Representatives
    alias: SALES-REPRESENTATIVE
    title: Representantes de Vendas
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region title-bar (
        name: Representantes de Vendas
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region sales-representative-grid (
        name: Sales Representatives Grid
        type: interactiveGrid
        source {
            location: localDatabase
            type: tableView
            tableName: TST_SALES_REPRESENTATIVE
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                update
            ]
        }
        pagination {
            type: page
            showTotalCount: true
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }

        savedReport PRIMARY (
            visibility: primary
            view {
                default: grid
            }
            singleRowView {
                displayedColumns: true
            }

            displayColumn (
                column: @ID
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @EMPLOYEE_CODE
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @TAX_ID
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @NICKNAME
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @FULL_NAME
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @EMAIL
                layout {
                    sequence: 6
                }
            )
            displayColumn (
                column: @CELL_PHONE
                layout {
                    sequence: 7
                }
            )
        )

        column ID (
            type: hidden
            layout {
                sequence: 5
            }
            source {
                databaseColumn: ID
                dataType: varchar2
                primaryKey: true
            }
            exportPrinting {
                includeInExportPrint: false
            }
        )

        column EMPLOYEE_CODE (
            type: textField
            heading {
                heading: Número de Matricula
            }
            layout {
                sequence: 10
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: EMPLOYEE_CODE
                dataType: varchar2
            }
            readOnly {
                type: always
            }
        )

        column TAX_ID (
            type: textField
            heading {
                heading: CPF
            }
            layout {
                sequence: 20
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: TAX_ID
                dataType: varchar2
            }
            readOnly {
                type: always
            }
        )

        column NICKNAME (
            type: textField
            heading {
                heading: Apelido
            }
            layout {
                sequence: 30
            }
            validation {
                maxLength: 20
            }
            source {
                databaseColumn: NICKNAME
                dataType: varchar2
            }
            readOnly {
                type: always
            }
        )

        column FULL_NAME (
            type: textField
            heading {
                heading: Nome Completo
            }
            layout {
                sequence: 40
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: FULL_NAME
                dataType: varchar2
            }
        )

        column EMAIL (
            type: textField
            heading {
                heading: Email
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 100
            }
            source {
                databaseColumn: EMAIL
                dataType: varchar2
            }
        )

        column CELL_PHONE (
            type: textField
            heading {
                heading: Nro Celular
            }
            layout {
                sequence: 60
            }
            validation {
                maxLength: 50
            }
            source {
                databaseColumn: CELL_PHONE
                dataType: varchar2
            }
        )
    )

    button create-sales-representative (
        buttonName: CREATE_SALES_REP
        label: Novo Representante de Vendas
        layout {
            sequence: 10
            region: @buttons
            slot: NEXT
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 5
                clearCache: 5
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    process save-sales-representative-grid (
        name: Interactive Grid - Save Data
        type: interactiveGridAutoRowProcessing
        editableRegion: @sales-representative-grid
        execution {
            sequence: 10
        }
    )

    dynamicAction refresh-sales-representative-grid (
        name: Refresh Sales Representatives Grid
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @buttons
        }

        action refresh-grid (
            action: refresh
            affectedElements {
                selectionType: region
                region: @sales-representative-grid
            }
            execution {
                sequence: 10
            }
        )
    )

)
